# benchmark pipeline: keep small text inputs + native refs + results; drop bulky model sets
predictions/_raw/
predictions/*/
!predictions/.gitkeep

# raw predictor downloads dropped under results/<Tool>/ -- extracted copies already
# live in predictions/_raw/ (also ignored); no need to commit the archives themselves
results/**/*.zip
results/**/*.tar.gz
results/**/*.gz

# Objective-2 re-ranking: per-decoy DockQ JSONs (results/dockq/<method>/<ID>_NN.json)
# are regenerable via rerank_prep.py + run_dockq.py -- keep only the rolled-up
# summary.csv / rerank*.csv / rerank.md
results/dockq/**/*_[0-9][0-9].json
